<mujoco model="flora_flow_desk_scene">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast" timestep="0.002" gravity="0 0 -9.81">
    <flag contact="enable" frictionloss="enable"/>
  </option>

  <default>
    <default class="table_geom">
      <geom type="box" rgba="0.88 0.84 0.78 1" friction="1.2 0.005 0.0001" solimp="0.95 0.99 0.001" solref="0.005 1"/>
    </default>
    <default class="can_geom">
      <geom density="120" friction="3.0 0.05 0.005" solimp="0.95 0.99 0.001" solref="0.004 1" rgba="0.16 0.52 0.56 1"/>
    </default>
    <default class="pot_geom">
      <geom density="2000" friction="1.2 0.01 0.001" solimp="0.95 0.99 0.001" solref="0.005 1" rgba="0.75 0.40 0.25 1"/>
    </default>
    <default class="water_particle">
      <geom type="sphere" size="0.007" density="1000" friction="0.02 0.001 0.0001"
            solimp="0.95 0.99 0.001" solref="0.004 1" rgba="0.20 0.60 0.95 0.85"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.55 0.75" rgb2="0.08 0.08 0.12" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.25 0.3" rgb2="0.15 0.2 0.25"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>

    <texture type="2d" name="wood_table" builtin="flat" rgb1="0.82 0.76 0.68" width="100" height="100"/>
    <material name="wood_table" texture="wood_table" reflectance="0.05"/>
    
    <material name="soil_mat" rgba="0.22 0.14 0.08 1"/>
    <material name="leaf_mat" rgba="0.15 0.62 0.22 1"/>
    <material name="can_mat" rgba="0.16 0.52 0.56 0.95"/>
  </asset>

  <include file="../franka_emika_panda/panda.xml"/>

  <worldbody>
    <light pos="0.5 0.0 1.8" dir="0 0 -1" diffuse="0.85 0.85 0.85" specular="0.2 0.2 0.2" directional="true"/>
    <light pos="-0.4 -0.5 1.5" dir="0.5 0.5 -1" diffuse="0.4 0.4 0.4" directional="true"/>

    <!-- Floor -->
    <geom name="floor" size="2 2 0.05" type="plane" material="groundplane" pos="0 0 0"/>

    <!-- Desk / Table: Top surface sits at Z = 0.40 m -->
    <body name="desk" pos="0.55 0.0 0.2">
      <geom name="desk_surface" class="table_geom" size="0.40 0.55 0.2" material="wood_table"/>
    </body>

    <!-- Potted Plant (Stationary target on desk) -->
    <body name="potted_plant" pos="0.42 -0.22 0.40">
      <!-- Ceramic Pot base and hollow rim walls -->
      <geom name="pot_base" class="pot_geom" type="cylinder" size="0.065 0.03" pos="0 0 0.03"/>
      <!-- Hollow rim walls to catch water particles -->
      <geom name="pot_wall_n" class="pot_geom" type="box" size="0.065 0.005 0.035" pos="0 0.06 0.065"/>
      <geom name="pot_wall_s" class="pot_geom" type="box" size="0.065 0.005 0.035" pos="0 -0.06 0.065"/>
      <geom name="pot_wall_e" class="pot_geom" type="box" size="0.005 0.065 0.035" pos="0.06 0 0.065"/>
      <geom name="pot_wall_w" class="pot_geom" type="box" size="0.005 0.065 0.035" pos="-0.06 0 0.065"/>
      <!-- Soil filling inside pot -->
      <geom name="soil" type="cylinder" size="0.055 0.005" pos="0 0 0.04" material="soil_mat"/>
      <!-- Plant Stem & Green Leaves -->
      <geom name="stem" type="cylinder" size="0.006 0.05" pos="0 0 0.09" material="leaf_mat"/>
      <geom name="leaf_1" type="ellipsoid" size="0.03 0.015 0.005" pos="0.02 0.01 0.12" quat="0.92 0 0.38 0" material="leaf_mat"/>
      <geom name="leaf_2" type="ellipsoid" size="0.03 0.015 0.005" pos="-0.02 -0.01 0.13" quat="0.92 0 -0.38 0" material="leaf_mat"/>
      <!-- Center target site for watering assessment -->
      <site name="plant_pot_center" pos="0 0 0.07" size="0.006" rgba="0.1 0.9 0.1 1"/>
    </body>

    <!-- Watering Can (Hollow reservoir with form-closure grasp handle) -->
    <body name="watering_can" pos="0.52 0.18 0.405">
      <freejoint name="watering_can_joint"/>
      <!-- Hollow container: Base plate -->
      <geom name="can_bottom" class="can_geom" type="box" size="0.035 0.035 0.004" pos="0 0 0.004"/>
      <!-- 4 perimeter walls -->
      <geom name="can_wall_n" class="can_geom" type="box" size="0.035 0.004 0.035" pos="0 0.031 0.039"/>
      <geom name="can_wall_s" class="can_geom" type="box" size="0.035 0.004 0.035" pos="0 -0.031 0.039"/>
      <geom name="can_wall_e" class="can_geom" type="box" size="0.004 0.035 0.035" pos="0.031 0 0.039"/>
      <geom name="can_wall_w" class="can_geom" type="box" size="0.004 0.035 0.02" pos="-0.031 0 0.024"/>
      
      <!-- Angled Pour Spout extending forward (-X) -->
      <geom name="can_spout" class="can_geom" type="capsule" size="0.008 0.03" pos="-0.048 0 0.05" quat="0.924 0 -0.383 0"/>

      <!-- Rear Form-Closure Grasp Handle: grip block bounded by wide top and bottom flanges -->
      <geom name="can_handle" class="can_geom" type="box" size="0.012 0.012 0.022" pos="0.082 0 0.045" friction="3.0 0.05 0.005"/>
      <geom name="can_flange_bot" class="can_geom" type="box" size="0.020 0.035 0.006" pos="0.082 0 0.018" friction="3.0 0.05 0.005"/>
      <geom name="can_strut_top" class="can_geom" type="capsule" size="0.005 0.022" pos="0.056 0 0.067" quat="0.707 0 0.707 0"/>
      <geom name="can_strut_bot" class="can_geom" type="capsule" size="0.005 0.022" pos="0.056 0 0.020" quat="0.707 0 0.707 0"/>
      
      <!-- Key reference sites -->
      <site name="can_grip_site" pos="0.082 0 0.045" size="0.006" rgba="1 1 0 1"/>
      <site name="can_spout_tip" pos="-0.075 0 0.07" size="0.006" rgba="0 0.8 1 1"/>
      <site name="can_center" pos="0 0 0.039" size="0.005" rgba="1 0 0 1"/>
    </body>

    <!-- Discrete Water Particles (inside watering can hollow reservoir) -->
    <body name="water_particle_0" pos="0.51 0.17 0.42">
      <freejoint name="particle_joint_0"/>
      <geom name="pgeom_0" class="water_particle"/>
    </body>
    <body name="water_particle_1" pos="0.53 0.17 0.42">
      <freejoint name="particle_joint_1"/>
      <geom name="pgeom_1" class="water_particle"/>
    </body>
    <body name="water_particle_2" pos="0.51 0.19 0.42">
      <freejoint name="particle_joint_2"/>
      <geom name="pgeom_2" class="water_particle"/>
    </body>
    <body name="water_particle_3" pos="0.53 0.19 0.42">
      <freejoint name="particle_joint_3"/>
      <geom name="pgeom_3" class="water_particle"/>
    </body>
    <body name="water_particle_4" pos="0.52 0.18 0.42">
      <freejoint name="particle_joint_4"/>
      <geom name="pgeom_4" class="water_particle"/>
    </body>
    <body name="water_particle_5" pos="0.51 0.18 0.43">
      <freejoint name="particle_joint_5"/>
      <geom name="pgeom_5" class="water_particle"/>
    </body>
    <body name="water_particle_6" pos="0.53 0.18 0.43">
      <freejoint name="particle_joint_6"/>
      <geom name="pgeom_6" class="water_particle"/>
    </body>
    <body name="water_particle_7" pos="0.52 0.17 0.43">
      <freejoint name="particle_joint_7"/>
      <geom name="pgeom_7" class="water_particle"/>
    </body>

    <!-- Cameras -->
    <camera name="overhead_cam" pos="0.65 0.0 1.20" xyaxes="0 1 0 -0.9806 0 0.1961" fovy="48"/>
    <camera name="third_person_cam" pos="1.15 0.35 0.80" xyaxes="-0.45 0.89 0 -0.32 -0.16 0.93" fovy="45"/>
    <camera name="pour_cam" pos="0.45 -0.65 0.65" xyaxes="1 0 0 0 0.5 0.866" fovy="45"/>
  </worldbody>
</mujoco>